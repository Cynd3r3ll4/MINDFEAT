<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingTop="8dp"
    android:paddingEnd="0dp"
    android:paddingBottom="8dp"
    android:background="?attr/colorSurface"
    tools:context=".MainActivity">

    <!-- App-Titel -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvAppTitel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:textStyle="bold"
            android:layout_gravity="center_vertical" />

        <ImageButton
            android:id="@+id/btnStatistik"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/statistik_oeffnen"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_statistics"
            app:tint="?attr/colorOnSurface" />

    </FrameLayout>

    <!-- Untertitel -->
    <TextView
        android:id="@+id/tvAppUntertitel"
        style="@style/TextAppearance.Mindfeat.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/app_untertitel"
        android:textSize="16sp" />

    <!-- Abstand unter dem Kopfbereich -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Funktionsbereich: Rezepte -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRezepte"
            style="@style/Widget.Mindfeat.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/alternativtext_rezepte">

            <ImageView
                android:id="@+id/ivRezepte"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Mindfeat.CardTitel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/menutext_rezepte" />

    </LinearLayout>

    <!-- Funktionsbereich: Essensplan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEssensplan"
            style="@style/Widget.Mindfeat.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/alternativtext_plan">

            <ImageView
                android:id="@+id/ivEssensplan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Mindfeat.CardTitel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/menutext_plan" />

    </LinearLayout>

    <!-- Funktionsbereich: Einkaufsliste -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEinkaufsliste"
            style="@style/Widget.Mindfeat.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/alternativtext_liste">

            <ImageView
                android:id="@+id/ivEinkaufsliste"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Mindfeat.CardTitel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/menutext_liste" />

    </LinearLayout>

</LinearLayout>