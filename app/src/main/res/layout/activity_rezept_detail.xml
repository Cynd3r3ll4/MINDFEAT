<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rezeptDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".view.activities.RezeptDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Kopfzeile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                style="@style/TextAppearance.Mindfeat.AppTitel" />

            <ImageButton
                android:id="@+id/btnRezeptDetailZurueck"
                style="@style/Widget.Mindfeat.NavigationIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/alternativtext_zurueck"
                android:src="@drawable/ic_zurueck" />

            <ImageButton
                android:id="@+id/btnRezeptDetailStartseite"
                style="@style/Widget.Mindfeat.NavigationIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/alternativtext_rezept_startseite"
                android:src="@drawable/ic_home" />

        </LinearLayout>

        <!-- Dynamischer Rezeptname -->
        <TextView
            android:id="@+id/tvRezeptTitelDetail"
            style="@style/TextAppearance.Mindfeat.SeitenTitel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            tools:text="Rezepttitel" />

        <!-- Rezeptbild -->
        <ImageView
            android:id="@+id/ivRezeptBildDetail"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="-24dp"
            android:layout_marginEnd="-24dp"
            android:contentDescription="@string/alternativtext_rezept_bild"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <!-- Kategorien -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgRezeptKategorien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- Zutatenüberschrift und Portionen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Mindfeat.LabelSerif"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/zutaten" />

            <TextView
                android:id="@+id/tvRezeptPortionen"
                style="@style/TextAppearance.Mindfeat.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Für 2 Portionen" />

        </LinearLayout>

        <!-- Zutaten werden dynamisch aus Room eingefügt -->
        <LinearLayout
            android:id="@+id/llRezeptZutaten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Arbeitsschritte -->
        <TextView
            style="@style/TextAppearance.Mindfeat.LabelSerif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/arbeitsschritte" />

        <!-- Arbeitsschritte werden dynamisch aus Room eingefügt -->
        <LinearLayout
            android:id="@+id/llRezeptZubereitung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>