<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rezeptErstellen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".view.activities.RezeptErstellenActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="24dp">

    <!-- Kopfzeile wie in der Rezeptübersicht -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAppTitel"
            style="@style/TextAppearance.Mindfeat.AppTitel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <ImageButton
            android:id="@+id/btnRezeptErstellenZurueck"
            style="@style/Widget.Mindfeat.NavigationIconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/alternativtext_zurueck"
            android:src="@drawable/ic_zurueck" />

        <ImageButton
            android:id="@+id/btnRezeptErstellenStartseite"
            style="@style/Widget.Mindfeat.NavigationIconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/alternativtext_rezept_startseite"
            android:src="@drawable/ic_home" />

    </LinearLayout>

    <!-- Seitenüberschrift wie in der Rezeptübersicht -->
    <TextView
        style="@style/TextAppearance.Mindfeat.SeitenTitel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/rezept_erstellen" />

    <!-- Formularinhalt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            style="@style/TextAppearance.Mindfeat.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rezept_titel" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Mindfeat.FeldContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etRezeptTitel"
                style="@style/Widget.Mindfeat.FeldEingabe"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/rezept_name"
                android:inputType="textCapSentences"
                android:singleLine="true" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Mindfeat.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/kategorie" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Mindfeat.FeldContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etRezeptKategorien"
                style="@style/Widget.Mindfeat.FeldEingabe"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/rezept_kategorie_beispiel"
                android:inputType="textCapSentences"
                android:singleLine="true" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Mindfeat.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/rezept_bild" />

        <ImageView
            android:id="@+id/ivRezeptVorschau"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="?attr/colorSurfaceVariant"
            android:contentDescription="@string/alternativtext_rezept_bild"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBildGalerie"
                style="@style/Widget.Mindfeat.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/rezept_galerie" />

            <Button
                android:id="@+id/btnBildKamera"
                style="@style/Widget.Mindfeat.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/rezept_kamera" />

        </LinearLayout>

        <!-- Portionen: ergibt [Eingabefeld] Portionen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Mindfeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rezept_portionen_ergebnis" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Mindfeat.FeldContainer"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/etRezeptPortionen"
                    style="@style/Widget.Mindfeat.FeldEingabe"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="@string/rezept_portionen_standard" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.Mindfeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/portionen" />

        </LinearLayout>

        <TextView
            style="@style/TextAppearance.Mindfeat.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/zutaten" />

        <LinearLayout
            android:id="@+id/layoutZutaten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <ImageButton
            android:id="@+id/btnZutatHinzufuegen"
            style="@style/Widget.Mindfeat.AktionsIconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:contentDescription="@string/alternativtext_zutat_hinzufuegen"
            android:src="@drawable/ic_plus" />

        <TextView
            style="@style/TextAppearance.Mindfeat.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/arbeitsschritte" />

        <LinearLayout
            android:id="@+id/layoutArbeitsschritte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <ImageButton
            android:id="@+id/btnArbeitsschrittHinzufuegen"
            style="@style/Widget.Mindfeat.AktionsIconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:contentDescription="@string/alternativtext_arbeitsschritt_hinzufuegen"
            android:src="@drawable/ic_plus" />

        <!-- Abbrechen- und Speichern-Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRezeptAbbrechen"
                style="@style/Widget.Mindfeat.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/abbrechen"
                app:iconPadding="8dp" />

            <Button
                android:id="@+id/btnRezeptSpeichern"
                style="@style/Widget.Mindfeat.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/speichern" />

        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</ScrollView>