<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rezeptErstellen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    tools:context=".view.activities.RezeptErstellenActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/rezept_erstellen"
            android:textColor="?attr/colorOnSurface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/rezept_titel"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etRezeptTitel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/rezept_name"
            android:inputType="textCapSentences"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/kategorie"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etRezeptKategorien"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/rezept_kategorie_beispiel"
            android:inputType="textCapSentences"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/rezept_bild"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/ivRezeptVorschau"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="?attr/colorSurfaceVariant"
            android:contentDescription="@string/alternativtext_rezept_bild"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBildGalerie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rezept_galerie" />

            <Button
                android:id="@+id/btnBildKamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/rezept_kamera" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/rezept_portionen"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etRezeptPortionen"
            android:layout_width="100dp"
            android:layout_height="52dp"
            android:inputType="number"
            android:text="@string/rezept_portionen_platzhalter" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/zutaten"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutZutaten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnZutatHinzufuegen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/zutaten_hinzufuegen" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/arbeitsschritte"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutArbeitsschritte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnArbeitsschrittHinzufuegen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/arbeitsschritte_hinzufuegen" />

        <Button
            android:id="@+id/btnRezeptSpeichern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/speichern" />

        <Button
            android:id="@+id/btnRezeptAbbrechen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/abbrechen" />

    </LinearLayout>

</ScrollView>