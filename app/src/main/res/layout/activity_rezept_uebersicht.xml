<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rezeptUebersicht"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    tools:context=".view.activities.RezeptUebersichtActivity">

    <!-- Kopfzeile: App-Name links, Home-Symbol rechts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAppTitel"
            style="@style/TextAppearance.Mindfeat.AppTitel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name" />

        <ImageButton
            android:id="@+id/btnRezeptStartseite"
            style="@style/Widget.Mindfeat.NavigationIconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/alternativtext_rezept_startseite"
            android:src="@drawable/ic_home" />

    </LinearLayout>

    <!-- Seitenüberschrift -->
    <TextView
        android:id="@+id/tvRezeptUeberschrift"
        style="@style/TextAppearance.Mindfeat.SeitenTitel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/rezept" />

    <!-- Suchbereich: bleibt außerhalb des Scrollbereichs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRezeptSuche"
            style="@style/TextAppearance.Mindfeat.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:text="@string/rezept_suche" />

        <!-- Eingabefeld und Plus-Button in einer Zeile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.Mindfeat.FeldContainer">

                    <EditText
                        android:id="@+id/etRezeptSuche"
                        style="@style/Widget.Mindfeat.FeldEingabe"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/rezept_suche_platzhalter"
                        android:inputType="text"
                        android:singleLine="true"
                        android:gravity="center_vertical" />

            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/btnRezeptHinzufuegen"
                style="@style/Widget.Mindfeat.AktionsIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/alternativtext_rezept_hinzufuegen"
                android:src="@drawable/ic_plus" />

        </LinearLayout>

    </LinearLayout>

    <!-- Nur dieser Bereich scrollt -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRezepte"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical" />

</LinearLayout>